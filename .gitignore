# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/

# secrets and local environment
.env
.env.*
!.env.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.secrets
credentials.json
service-account*.json

# local source corpus (not part of the repository)
base_drive/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel/

# supabase CLI
supabase/.temp/
.supabase/

# cloudflare workers
.wrangler/
workers/*/.wrangler/
workers/*/dist/
workers/*/node_modules/

# typescript
*.tsbuildinfo
next-env.d.ts
