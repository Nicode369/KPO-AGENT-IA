# Entorno local de la aplicación. No versiones valores reales.
APP_ORIGIN=http://localhost:3000

# Supabase: mantener las claves privilegiadas solo en el servidor.
# La service role solo se usa para bootstrap y tareas administrativas fuera del navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API y modelos. No agregar tokens reales a este archivo.
AI_PROVIDER=
AI_MODEL=
AI_EMBEDDING_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
