# Entorno local de la aplicación. No versiones valores reales.
APP_ORIGIN=http://localhost:3000

# Supabase: mantener las claves privilegiadas solo en el servidor.
# La service role solo se usa para bootstrap y tareas administrativas fuera del navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Los modelos y proveedor de IA se configuran en workers/kpo-ingest/wrangler.jsonc.
# Cloudflare Worker de ingesta y agente (fases 4 y 5). Solo servidor.
INGEST_WORKER_URL=

# Script opcional para ingerir base_drive. Solo se usa en local.
# No versiones credenciales reales; usa una cuenta group_admin del grupo destino.
INGEST_EMAIL=
INGEST_PASSWORD=
INGEST_GROUP_ID=
INGEST_GROUP_SLUG=kpo
BASE_DRIVE_DIR=

# Demos públicas: cuentas compartidas para los botones DEMO KPO y DEMO CLIMA.
# Mantén las contraseñas solo en el servidor y rótalas antes de publicar.
DEMO_KPO_EMAIL=demo.kpo@example.com
DEMO_KPO_PASSWORD=
DEMO_KPO_GROUP_SLUG=kpo
DEMO_CLIMA_EMAIL=demo.analista@example.com
DEMO_CLIMA_PASSWORD=
DEMO_CLIMA_GROUP_SLUG=riesgo-climatico
DEMO_RATE_LIMIT_PER_MINUTE=60
DEMO_WORKER_URL=

# Compatibilidad con la configuración anterior de la demo climática.
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
DEMO_GROUP_SLUG=
